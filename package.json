{
  "name": "backend-app",
  "version": "1.0.0",
  "description": "Codebot SaaS backend - NestJS authentication system (BetterAuth + Neon Postgres + TypeORM)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/modules/mail/templates','dist/modules/mail/templates',{recursive:true})\"",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only -- src/main.ts",
    "db:ping": "ts-node scripts/db-ping.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d dist/database/typeorm/data-source.js",
    "migration:gen": "typeorm-ts-node-commonjs migration:generate -d dist/database/typeorm/data-source.js",
    "auth:schema": "ts-node scripts/generate-auth-schema.ts --apply",
    "init:db": "npm run auth:schema",
    "test": "jest"
  },
  "keywords": [
    "nestjs",
    "better-auth",
    "typeorm",
    "neon",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/throttler": "^5.2.0",
    "better-auth": "^1.7.10",
    "dotenv": "^18.0.8",
    "helmet": "^8.3.0",
    "joi": "^18.3.0",
    "kysely": "^0.29.7",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
