# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Public base URL of this API (BetterAuth baseURL / OAuth issuer)
APP_URL=http://localhost:3000

# ─── Database (Neon PostgreSQL, pooled connection) ─────────────────────────────
# Both layers (BetterAuth/Kysely + TypeORM) share this URL. Must be SSL.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ─── BetterAuth ───────────────────────────────────────────────────────────────
# Session/cookie/token signing key. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated trusted origins (kept in sync with CORS). No trailing slash.
CORS_ORIGIN_URLS=http://localhost:5173

# ─── Roles / first-admin bootstrap ────────────────────────────────────────────
# Comma-separated emails; verified users with these emails are promoted to admin.
ADMIN_EMAIL=you@example.com

# ─── SMTP / Nodemailer (real transport in production) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Codebot" <you@example.com>

# ─── OAuth (Phase 2 — leave empty until configured) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Rate limiting (Phase 3) ──────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
