# Backend Environment Variables
# Copy this to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/your_database_name
BETTER_AUTH_SECRET=your-super-secret-key-change-this-to-something-random-and-secure

# Frontend URL (for BetterAuth redirects)
FRONTEND_URL=http://localhost:3001

# CORS Origins (comma-separated list)
CORS_ORIGIN_URLS=http://localhost:3001,http://localhost:5173

# Node Environment
NODE_ENV=development

# Admin emails that should be promoted to admin role
ADMIN_EMAILS=

# OAuth Provider Configuration (if needed)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret